# ==============================================================================
# CODE CLEVER / ZENFLOW - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=4000

# TiDB Cloud (MySQL-Compatible) Database Configuration
DATABASE_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DATABASE_PORT=4000
DATABASE_USER=your_tidb_username.root
DATABASE_PASSWORD=your_tidb_password
DATABASE_NAME=code_clever
DATABASE_SSL=true
DATABASE_POOL_SIZE=10

# Security & JSON Web Tokens
JWT_SECRET=generate_a_secure_64_character_hex_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Cross-Origin Resource Sharing (CORS) & Custom Domains
# Comma-separated list of allowed frontend domains
CORS_ORIGIN=https://codeclever.com,http://localhost:5173
FRONTEND_URL=https://codeclever.com

# Frontend API Base URL (Used in React build / Vercel / Netlify)
VITE_API_BASE_URL=https://api.codeclever.com/api

# Cloudinary Media Storage (Receipts & User Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ALTCHA Human Verification (Proof-of-Work HMAC Key)
ALTCHA_HMAC_KEY=generate_a_secure_random_altcha_hmac_secret_key_here
ALTCHA_DIFFICULTY=50000

# Rate Limiting Configuration (Requests per window)
RATE_LIMIT_GENERAL=300
RATE_LIMIT_SENSITIVE=60
